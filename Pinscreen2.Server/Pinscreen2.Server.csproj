<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0-windows + WinForms purely for the notification-area icon
         (TrayIcon.cs). The server is Windows-only in practice; the tray is
         skipped by the no-tray switch or when there is no desktop to attach
         to. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pinscreen2.Server</RootNamespace>
    <AssemblyName>Pinscreen2.Server</AssemblyName>
    <!-- Console app that also pumps a WinForms message loop: keep the console
         subsystem so stdout still reaches server.log. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embedded so a self-contained single-file publish stays one file. -->
    <EmbeddedResource Include="index.html" LogicalName="Pinscreen2.Server.index.html" />
    <EmbeddedResource Include="favicon.ico" LogicalName="Pinscreen2.Server.favicon.ico" />
  </ItemGroup>
</Project>
